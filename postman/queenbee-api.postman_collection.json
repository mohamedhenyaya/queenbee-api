{
  "info": {
    "name": "Queen Bee API",
    "description": "Requêtes de l'API Queen Bee (TP 2). Lancer le serveur avec npm run dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "GET /health",
      "request": { "method": "GET", "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('status ok', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));"
      ] } }]
    },
    {
      "name": "GET /api/hives",
      "request": { "method": "GET", "url": "{{base_url}}/api/hives" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('Liste de ruches', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
      ] } }]
    },
    {
      "name": "GET /api/hives?site_id=SN-CASA",
      "request": { "method": "GET", "url": "{{base_url}}/api/hives?site_id=SN-CASA" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('Seulement SN-CASA', () => {",
        "  const liste = pm.response.json();",
        "  pm.expect(liste).to.not.be.empty;",
        "  liste.forEach((h) => pm.expect(h.site_id).to.eql('SN-CASA'));",
        "});"
      ] } }]
    },
    {
      "name": "GET /api/hives/:id",
      "request": { "method": "GET", "url": "{{base_url}}/api/hives/SN-CASA-001" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('Bonne ruche', () => pm.expect(pm.response.json().id).to.eql('SN-CASA-001'));"
      ] } }]
    },
    {
      "name": "GET /api/hives/:id - ruche inconnue (404)",
      "request": { "method": "GET", "url": "{{base_url}}/api/hives/XX-NOPE-999" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404', () => pm.response.to.have.status(404));"
      ] } }]
    },
    {
      "name": "POST /api/hives/:id/measures",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/hives/SN-CASA-001/measures",
        "body": { "mode": "raw", "raw": "{\n  \"hive_id\": \"SN-CASA-001\",\n  \"site_id\": \"SN-CASA\",\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"position_lat\": 12.5743,\n  \"position_lon\": -16.2873,\n  \"weight_kg\": 36.84,\n  \"temp_internal_c\": 34.4,\n  \"temp_external_c\": 27.1,\n  \"humidity_pct\": 64,\n  \"acoustic_activity_score\": 0.42,\n  \"battery_pct\": 88\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201', () => pm.response.to.have.status(201));",
        "pm.test('Timestamp de la trame conservé', () => pm.expect(pm.response.json().timestamp).to.eql('2026-10-31T10:00:00Z'));"
      ] } }]
    },
    {
      "name": "POST /api/hives/:id/measures - sans timestamp (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/hives/SN-CASA-001/measures",
        "body": { "mode": "raw", "raw": "{\n  \"weight_kg\": 36.84\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));"
      ] } }]
    },
    {
      "name": "POST /api/hives/:id/measures - hive_id différent du chemin (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/hives/SN-CASA-002/measures",
        "body": { "mode": "raw", "raw": "{\n  \"hive_id\": \"SN-CASA-001\",\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"weight_kg\": 36.84\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));"
      ] } }]
    },
    {
      "name": "POST /api/hives/:id/measures - ruche inconnue (404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/hives/XX-NOPE-999/measures",
        "body": { "mode": "raw", "raw": "{\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"weight_kg\": 36.84\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404', () => pm.response.to.have.status(404));"
      ] } }]
    }
  ]
}
